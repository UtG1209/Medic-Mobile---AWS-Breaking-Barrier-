# Backend API base URL (Vite reads this at dev and build time). A value on the command line overrides it;
# an empty value (VITE_API_URL= npm run dev) uses the built-in sample data with no backend.

# Local: the dev:local backend (cd Backend && npm run dev:local).
VITE_API_URL=http://localhost:8787

# AWS: the APIURL output of OrchestratorLambdaStack, without the trailing slash. To use it, comment out
# the local line above and uncomment this one.
# VITE_API_URL=https://<api-id>.execute-api.us-west-2.amazonaws.com

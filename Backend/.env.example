# Template only. Copy to Backend/.env and fill in. No secrets or AWS keys belong in this file:
# credentials come from your AWS SSO profile or the runtime IAM role, never from here.
# Table, bucket and queue values come from the `cdk deploy` outputs of Infra/ (see Infra/README.md).
AWS_REGION=us-west-2
TABLE_RUNS=
TABLE_STEPS=
TABLE_VERSIONS=
TABLE_COMMENTS=
TABLE_AUDIT=
ARTIFACT_BUCKET=
# Required when RUN_MODE=container; not used when RUN_MODE=agentcore or lambda.
UPLOAD_QUEUE_URL=
# container (default), agentcore or lambda. See "Running on AgentCore" and "Running on Lambda" in README.md.
RUN_MODE=container
MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
PORT=8080
# Optional: PRICES_JSON={"us.anthropic.claude-haiku-4-5-20251001-v1:0":{"inPerMTok":1,"outPerMTok":5}}
# bedrock (default: Strands runs in this process) or agentcore (Strands runs on an AgentCore Runtime; MODEL_ID is passed to it).
MODEL_BACKEND=bedrock
# Required only when MODEL_BACKEND=agentcore, e.g. arn:aws:bedrock-agentcore:us-west-2:123456789012:runtime/<id>
AGENTCORE_RUNTIME_ARN=
# Optional: model for the fill_logic draft (default MODEL_ID). A different model also needs Bedrock IAM access (Infra/).
FILL_MODEL_ID=
# Optional: prompt files of the revision loop (default extraction/revise_instruction_prompt.txt and extraction/revise_prompt.txt next to the build).
# The revision steps use MODEL_ID / FILL_MODEL_ID / MODEL_BACKEND like fill_logic, so no extra Bedrock access is needed.
REVISE_INSTRUCTION_PROMPT=
REVISE_PROMPT=
# Check inputs (DEC-020). Empty: run artifacts, then the repository defaults. "none" switches one off.
GOLDEN_CASES_PATH=
COMPILE_SETTINGS_PATH=
# Optional: a second, independent logic model (JSON) for the cross-check comparison (DEC-035). The checks first read
# runs/<id>/inputs/cross_check_model.json from the artifact bucket, then this file; there is no default, and without one
# the comparison does not run (contextNotice says so).
CROSS_CHECK_MODEL_PATH=
# Optional: largest input PDF ingest downloads, in bytes (default 52428800), and MAX_PAGES (default 200).
MAX_PDF_BYTES=
# Optional: level of the API request/error log on stdout (fatal, error, warn, info, debug, trace, silent). Default info.
LOG_LEVEL=
# Optional quote-support scoring after the checks (advisory, Backend/scoring). Empty: off.
# Set to a Bedrock model or us. inference profile id other than the drafting model, e.g.
# us.meta.llama4-scout-17b-instruct-v1:0. Needs Strands Evals: SCORING_PYTHON is a Python with
# Backend/scoring/requirements.txt installed (the Docker image sets /opt/scoring/bin/python).
JUDGE_MODEL_ID=
SCORING_PYTHON=
# Optional: judge samples per item (default 3, at most 9).
SCORING_SAMPLES=

# Python scripts: Backend/extraction/run_extraction.py reads MODEL_ID (above); Backend/cross-check/run_extraction.py
# reads CROSSCHECK_MODEL_ID. Neither is read by the server. Model ids are us. inference profile ids. Find them with:
#   aws bedrock list-inference-profiles --region us-west-2
CROSSCHECK_MODEL_ID=
# Optional output cap for the cross-check call (default 16000).
CROSSCHECK_MAX_TOKENS=
# Optional: the Python scripts price calls from PRICES_JSON (above) when set; the older
# PRICE_IN_PER_MTOK / PRICE_OUT_PER_MTOK (USD per million tokens) still work when it is not.
PRICE_IN_PER_MTOK=
PRICE_OUT_PER_MTOK=
# Optional cap in USD on the recorded cost of one run; when reached the next attempt is refused (default: no cap).
RUN_BUDGET_USD=

# Optional chat settings: model (default MODEL_ID), max chat cost per run in USD (default 1), requests per user per minute (default 10).
CHAT_MODEL_ID=
CHAT_MAX_COST_USD=
CHAT_RATE_PER_MIN=
# Per-run chat token cap, used when PRICES_JSON has no price for the chat model (default 200000).
CHAT_MAX_TOKENS=
# Officer agent: model (default MODEL_ID) and max cost per run in USD (default 2). A different model needs Bedrock IAM access (Infra/).
OFFICER_AGENT_MODEL_ID=
OFFICER_AGENT_MAX_COST_USD=
